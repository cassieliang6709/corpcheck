# ── Database (service layer, asyncpg) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_rag
DB_USER=postgres
DB_PASSWORD=postgres

# ── Database (ingestion pipeline, psycopg2) ──────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_rag

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Retrieval defaults ───────────────────────────────────────────────────────
DEFAULT_K=5
DEFAULT_ALPHA=0.7
COMPANY_BOOST=1.5
FILING_TYPE_BOOST=1.3
FISCAL_YEAR_BOOST=1.3

# ── LLM (OpenAI-compatible SGLang endpoint) ──────────────────────────────────
# Leave SGLANG_BASE_URL empty to run retrieval-only; /chat then returns 503.
SGLANG_BASE_URL=
SGLANG_MODEL=Qwen/Qwen3.5-397B-A17B-FP8
SGLANG_API_KEY=
SGLANG_MAX_TOKENS=32768

# ── API ──────────────────────────────────────────────────────────────────────
# Empty API_KEY disables auth on /chat entirely.
API_KEY=
CORS_ORIGINS=*

# ── Ingestion ────────────────────────────────────────────────────────────────
SEC_USER_AGENT=corpcheck-pipeline your-email@example.com
SEC_DOWNLOAD_DIR=./data/sec_filings
LOG_LEVEL=INFO
LOG_FILE=./pipeline.log
